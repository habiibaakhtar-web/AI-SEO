NODE_ENV=development
PORT=5000
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
# For Hostinger use MySQL. Local development keeps existing embedded data when DB_NAME is blank.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Optional legacy PostgreSQL for local development only.
DATABASE_URL=
DATABASE_SSL=false
JWT_SECRET=
# Node calls the AI provider directly. Python is no longer required.
LLM_API_KEY=
LLM_MODEL=openrouter/auto
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MAX_TOKENS=4096
DATA_DIR=
# Password reset delivery (optional locally, required for production reset emails).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

