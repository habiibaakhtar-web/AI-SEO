NODE_ENV=production
HOST=0.0.0.0
FRONTEND_ORIGIN=https://YOUR-ASSIGNED-NAME.hostingersite.com
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=YOUR_HOSTINGER_DATABASE_NAME
DB_USER=YOUR_HOSTINGER_DATABASE_USER
DB_PASSWORD=YOUR_HOSTINGER_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# AI is optional. Add these privately in hPanel to enable generation.
LLM_API_KEY=
LLM_MODEL=openrouter/auto
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MAX_TOKENS=4096
# Optional password reset delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
