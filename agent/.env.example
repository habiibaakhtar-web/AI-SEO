# Copy this file to agent/.env. The Python service reads agent/.env.
# Create your OpenRouter key at https://openrouter.ai/settings/keys
AGENT_PORT=8000
# npm run dev shares this private token automatically.
AGENT_SERVICE_TOKEN=
LLM_API_KEY=
LLM_MODEL=openrouter/auto
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MAX_TOKENS=4096
APP_URL=http://127.0.0.1:5173
